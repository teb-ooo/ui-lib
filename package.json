{
  "name": "@teb-ooo/ui",
  "version": "0.8.0",
  "description": "The playground design system: theme, atomic components, email base layout.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teb-ooo/ui-lib.git"
  },
  "publishConfig": {
    "registry": "http://npm-registry:4873/"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./stories": {
      "types": "./dist/stories.d.ts"
    },
    "./stories/*": "./stories/*",
    "./theme.css": "./theme.css",
    "./email/*": "./email/*",
    "./package.json": "./package.json",
    "./cmdk": {
      "types": "./dist/cmdk/index.d.ts",
      "import": "./dist/cmdk/index.js",
      "default": "./dist/cmdk/index.js"
    }
  },
  "files": [
    "dist",
    "stories",
    "theme.css",
    "fonts",
    "email",
    "README.md",
    "docs/*.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && npm run build:stories",
    "build:stories": "node --experimental-strip-types --no-warnings scripts/build-stories.ts",
    "build:email-tokens": "node --experimental-strip-types --no-warnings scripts/build-email-tokens.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "check:release-age": "node /playground/brain/rules/tools/check-release-age.mjs .",
    "docs:build": "npm --prefix docs ci && npm --prefix docs run build",
    "release": "npm run build && npm run docs:build"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.0.0",
    "lucide-react": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@tanstack/react-router": "^1.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "culori": "^4.0.2",
    "geist": "^1.7.2",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "@tanstack/react-router": "^1.170.36",
    "@testing-library/dom": "^10.4.2"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-router": {
      "optional": true
    }
  }
}
