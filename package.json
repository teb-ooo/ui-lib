{
  "name": "@teb-ooo/ui",
  "version": "0.1.0",
  "description": "The factory design system: theme, atomic components, email base layout.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teb-ooo/ui.git"
  },
  "publishConfig": {
    "registry": "http://npm-registry:4873/"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./email/*": "./email/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "theme.css",
    "fonts",
    "email",
    "README.md",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:email-tokens": "node --experimental-strip-types --no-warnings scripts/build-email-tokens.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gallery": "vite --config gallery/vite.config.ts",
    "gallery:build": "vite build --config gallery/vite.config.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@base-ui/react": "^1.0.0",
    "lucide-react": "^1.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "culori": "^4.0.2",
    "geist": "^1.7.2",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
